# Postgres connection string. On Vercel this is set automatically when you
# connect a Neon database (Storage tab). Leave empty locally to use the
# embedded database in ./.data
DATABASE_URL=

# Login secrets (required in production)
PARENT_PIN=choose-a-parent-password
NANNY_PIN=choose-a-nanny-password
# Long random string, e.g. `openssl rand -base64 32`
SESSION_SECRET=
